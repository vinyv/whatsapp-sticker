# Local Worker Configuration
WORKER_PORT=3001
WORKER_SECRET=change-me-to-a-random-secret

# yt-dlp auto-update: channel (stable | nightly | master) and interval in ms (0 = off)
YTDLP_UPDATE_CHANNEL=nightly
YTDLP_UPDATE_INTERVAL_MS=43200000

# x.com cookies: read live from a browser (e.g. firefox), or use X_COOKIES_PATH (default ../cookies-x.txt)
# X_COOKIES_FROM_BROWSER=firefox
